# Copie para .streamlit/secrets.toml (NÃO versionar) ou cole em
# Streamlit Cloud → App → Settings → Secrets.
# Sem este arquivo o app usa o SQLite local em dados/plano.db.

[database]
# Neon (PostgreSQL). Na rede MRS o SSL precisa ser "direto" (sslnegotiation=direct).
url = "postgresql+psycopg2://USUARIO:SENHA@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require&sslnegotiation=direct"
